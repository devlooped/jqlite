{
  "name": "@devlooped/jqlite",
  "version": "1.0.0",
  "description": "jqlite, a portable profile of the jq language: the TypeScript port of the JQLite reference engine",
  "license": "MIT",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./node": {
      "types": "./dist/src/node.d.ts",
      "default": "./dist/src/node.js"
    }
  },
  "files": [
    "dist/src"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prelude": "node scripts/generate-prelude.mjs",
    "build": "node scripts/generate-prelude.mjs && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.core.json --noEmit",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "bench": "node dist/bench/crossBench.js",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devlooped/jqlite.git",
    "directory": "typescript"
  },
  "homepage": "https://github.com/devlooped/jqlite",
  "bugs": {
    "url": "https://github.com/devlooped/jqlite/issues"
  },
  "author": "Daniel Cazzulino",
  "keywords": [
    "jq",
    "json",
    "query",
    "jqlite"
  ]
}
